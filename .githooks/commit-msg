#!/usr/bin/env bash
# Opt-in commit-msg hook (#29). Enable once per clone with
#   git config core.hooksPath .githooks
# Checks the message against Conventional Commits, the rule CI applies to
# pull request titles (CONTRIBUTING.md). Skip it for one commit with
# `git commit --no-verify`.
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: $0 <commit message file>" >&2
  exit 2
fi
# The message path is made absolute before changing to the top of the work
# tree, so the hook also works when run by hand from a subdirectory.
case "$1" in
  /*) message=$1 ;;
  *) message="$PWD/$1" ;;
esac
cd "$(git rev-parse --show-toplevel)"
exec cargo xtask check-commit-msg "$message"
